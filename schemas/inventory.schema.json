{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://red-team-agent-orchestration/schemas/inventory.schema.json",
  "title": "Resource Inventory",
  "description": "Shared resource inventory built once by the Inventory & Scope Agent and consumed by all domain agents to avoid duplicate enumeration and throttling.",
  "type": "object",
  "required": ["engagement_id", "generated_at", "subscriptions", "resources"],
  "properties": {
    "engagement_id": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "tenant_id": { "type": "string" },
    "subscriptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "state": { "type": "string" }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string", "description": "Azure resource type, e.g. Microsoft.Storage/storageAccounts" },
          "resource_group": { "type": "string" },
          "subscription_id": { "type": "string" },
          "location": { "type": "string" },
          "kind": { "type": "string" },
          "tags": { "type": "object" }
        }
      }
    },
    "coverage_limitations": {
      "type": "array",
      "description": "Resource types or scopes the caller lacked permission to enumerate",
      "items": {
        "type": "object",
        "properties": {
          "scope": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
